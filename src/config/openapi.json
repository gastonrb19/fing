{
  "openapi": "3.0.0",
  "info": {
    "title": "Fing API - Sistema de Finanzas Personales y Gastos Compartidos",
    "version": "2.0.0",
    "description": "API REST integral para Fing. Incluye gestión de autenticación basada en cookies HTTP-Only y tokens JWT, administración de gastos maestros con división en cuotas y porcentajes equitativos entre amigos, auditoría de rechazos y reasignación de deudas, y relaciones de amistad."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Servidor Local de Desarrollo"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "token",
        "description": "Cookie HTTP-Only 'token' inyectada automáticamente por el servidor al iniciar sesión con éxito (/auth/login)."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT enviado en la cabecera 'Authorization: Bearer <token>'."
      }
    },
    "schemas": {
      "StandardResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "code_message": {
            "type": "string",
            "example": "ABC"
          },
          "len": {
            "type": "integer",
            "example": 1
          },
          "data": {
            "type": "object"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "example": 401
              },
              "message": {
                "type": "string",
                "example": "No autorizado: Debes iniciar sesión"
              }
            }
          }
        }
      },
      "LoginDTO": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Username o correo electrónico del usuario",
            "example": "gaston"
          },
          "username": {
            "type": "string",
            "example": "gaston"
          },
          "email": {
            "type": "string",
            "example": "gaston.nuevo@test.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "123456"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Login exitoso"
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 1
              },
              "username": {
                "type": "string",
                "example": "gaston"
              },
              "email": {
                "type": "string",
                "example": "gaston.nuevo@test.com"
              },
              "phone": {
                "type": "string",
                "example": "+56912345678"
              }
            }
          },
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "CreateUserDTO": {
        "type": "object",
        "required": [
          "username",
          "email",
          "hashedPassword",
          "phone"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "juan_perez"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "juan@correo.com"
          },
          "hashedPassword": {
            "type": "string",
            "format": "password",
            "example": "ClaveSegura123!"
          },
          "phone": {
            "type": "string",
            "example": "+56998765432"
          }
        }
      },
      "UpdateUserDTO": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "juan_perez_editado"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "juan_nuevo@correo.com"
          },
          "phone": {
            "type": "string",
            "example": "+56911223344"
          }
        }
      },
      "ParticipantDTO": {
        "type": "object",
        "required": [
          "userId",
          "percentage"
        ],
        "properties": {
          "userId": {
            "type": "integer",
            "description": "ID del usuario participante",
            "example": 1
          },
          "percentage": {
            "type": "number",
            "description": "Porcentaje del gasto asumido (ej: 50%)",
            "example": 50
          }
        }
      },
      "CreateSpendDTO": {
        "type": "object",
        "required": [
          "name",
          "amount",
          "userId",
          "subcategoryId",
          "minDayToPayment"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre o concepto del gasto",
            "example": "Cena de Cumpleaños"
          },
          "amount": {
            "type": "number",
            "description": "Monto total del gasto",
            "example": 60000
          },
          "userId": {
            "type": "integer",
            "description": "ID del creador/dueño del gasto",
            "example": 1
          },
          "subcategoryId": {
            "type": "integer",
            "description": "ID de la subcategoría asociada",
            "example": 3
          },
          "minDayToPayment": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "description": "Día sugerido de pago (1 al 31)",
            "example": 15
          },
          "maxDayToPayment": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "description": "Día límite de pago (opcional)",
            "example": 20
          },
          "totalInstallment": {
            "type": "integer",
            "default": 1,
            "description": "Cantidad total de cuotas",
            "example": 3
          },
          "startPayment": {
            "type": "string",
            "description": "Fecha de inicio del pago (YYYY-MM-DD o ISO)",
            "example": "2026-10-15"
          },
          "fkTypeSpend": {
            "type": "integer",
            "default": 1,
            "description": "Tipo de gasto (1: Fijo, 2: Variable, etc.)",
            "example": 1
          },
          "participants": {
            "type": "array",
            "description": "Matriz de división del gasto entre usuarios (la suma debe ser 100%)",
            "items": {
              "$ref": "#/components/schemas/ParticipantDTO"
            },
            "example": [
              {
                "userId": 1,
                "percentage": 50
              },
              {
                "userId": 2,
                "percentage": 50
              }
            ]
          }
        }
      },
      "UpdateSpendDTO": {
        "type": "object",
        "properties": {
          "spend": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "example": "Cena de Cumpleaños (Actualizado)"
              },
              "amount": {
                "type": "number",
                "example": 65000
              },
              "subcategoryId": {
                "type": "integer",
                "example": 3
              },
              "minDayToPayment": {
                "type": "integer",
                "example": 15
              },
              "maxDayToPayment": {
                "type": "integer",
                "example": 22
              }
            }
          }
        }
      },
      "UpdateInstallmentUserPaymentDTO": {
        "type": "object",
        "properties": {
          "paymentDone": {
            "type": "boolean",
            "description": "Indica si la cuota ya fue pagada",
            "example": true
          },
          "paidAmount": {
            "type": "number",
            "description": "Monto pagado (debe ser el total asignado)",
            "example": 20000
          },
          "accepted": {
            "type": "boolean",
            "description": "Indica si el deudor aceptó la cuota",
            "example": true
          },
          "userId": {
            "type": "integer",
            "description": "ID de un nuevo usuario responsable para reasignar la cuota",
            "example": 2
          }
        }
      },
      "CreateFriendRequestDTO": {
        "type": "object",
        "required": [
          "receiverId"
        ],
        "properties": {
          "receiverId": {
            "type": "integer",
            "description": "ID del usuario a quien se le envía la solicitud",
            "example": 2
          }
        }
      },
      "RespondFriendRequestDTO": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACCEPTED",
              "REJECTED"
            ],
            "description": "Decisión del receptor",
            "example": "ACCEPTED"
          }
        }
      },
      "CategoryDTO": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Alimentación"
          },
          "description": {
            "type": "string",
            "example": "Gastos de supermercado, restaurantes y comida"
          }
        }
      },
      "SubcategoryDTO": {
        "type": "object",
        "required": [
          "name",
          "categoryId"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Restaurantes"
          },
          "categoryId": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "TypeSpendDTO": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Variable"
          }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Iniciar sesión de usuario",
        "description": "Valida credenciales contra la BD. Si son correctas, genera un JWT y emite una cookie HTTP-Only segura ('token'). Para desarrollo y testing se admite la clave '123456'.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login exitoso con cookie HTTP-Only inyectada",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "example": "token=eyJhbGciOi...; Path=/; HttpOnly; SameSite=Lax"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Identificador o contraseña no proporcionados"
          },
          "401": {
            "description": "Credenciales inválidas"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Obtener perfil del usuario autenticado (Protegido)",
        "description": "Verifica la sesión activa mediante la cookie HTTP-Only 'token' o la cabecera 'Authorization: Bearer <token>' y retorna el usuario actual.",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          },
          "401": {
            "description": "No autorizado / Sesión expirada"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Cerrar sesión de usuario (Protegido)",
        "description": "Limpia la cookie HTTP-Only de sesión ('token') en el navegador.",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sesión cerrada correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Listar todos los usuarios",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Crear un nuevo usuario (Registro público)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserDTO"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado exitosamente"
          },
          "400": {
            "description": "Usuario, email o teléfono ya registrado"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Obtener usuario por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          },
          "404": {
            "description": "Usuario no encontrado"
          }
        }
      },
      "put": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Actualizar datos de un usuario",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuario actualizado"
          }
        }
      }
    },
    "/spends": {
      "get": {
        "tags": [
          "Gastos Maestros"
        ],
        "summary": "Listar gastos generales (Protegido)",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Gastos Maestros"
        ],
        "summary": "Crear un gasto maestro con matriz de cuotas y particiones (Protegido)",
        "description": "Registra un gasto y genera automáticamente las cuotas ('PlannedInstallments') y pagos por usuario ('InstallmentUserPayments') según el arreglo 'participants' (cuya suma debe ser exactamente 100%).",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSpendDTO"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Gasto y matriz de cuotas creados exitosamente"
          },
          "400": {
            "description": "Error de validación (ej. sumatoria de porcentajes distinta de 100)"
          },
          "401": {
            "description": "No autorizado"
          }
        }
      }
    },
    "/spends/{id}": {
      "get": {
        "tags": [
          "Gastos Maestros"
        ],
        "summary": "Obtener detalle completo de un gasto con sus cuotas y deudores (Protegido)",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle del gasto con PlannedInstallments e InstallmentUserPayments"
          },
          "404": {
            "description": "Gasto no encontrado"
          }
        }
      },
      "put": {
        "tags": [
          "Gastos Maestros"
        ],
        "summary": "Editar configuración de un gasto (Protegido)",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSpendDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gasto actualizado"
          },
          "400": {
            "description": "Bloqueado si alguna cuota ya fue pagada"
          }
        }
      },
      "delete": {
        "tags": [
          "Gastos Maestros"
        ],
        "summary": "Eliminar un gasto (Protegido)",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Gasto eliminado"
          }
        }
      }
    },
    "/users/{id_user}/spends": {
      "get": {
        "tags": [
          "Gastos Maestros"
        ],
        "summary": "Consultar gastos asociados a un usuario con filtros avanzados (Protegido)",
        "description": "Retorna los gastos donde el usuario participa como creador o deudor invitado. Soporta filtros de categoría, fechas, estado y rol.",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id_user",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filtrar por ID de Categoría"
          },
          {
            "name": "subcategory",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filtrar por ID de Subcategoría"
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Fecha desde (YYYY-MM-DD)"
          },
          {
            "name": "until",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Fecha hasta (YYYY-MM-DD)"
          },
          {
            "name": "done",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Filtrar por estado pagado/pendiente"
          },
          {
            "name": "role",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "owner",
                "guest"
              ]
            },
            "description": "Filtrar por rol en el gasto"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/installmentuserpayments": {
      "get": {
        "tags": [
          "Cuotas y Pagos"
        ],
        "summary": "Listar pagos de cuotas asignados (Protegido)",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de pagos"
          }
        }
      },
      "post": {
        "tags": [
          "Cuotas y Pagos"
        ],
        "summary": "Registrar pago individual (Protegido)",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Pago registrado"
          }
        }
      }
    },
    "/installmentuserpayments/rejected": {
      "get": {
        "tags": [
          "Cuotas y Pagos"
        ],
        "summary": "Auditoría de cuotas rechazadas por amigos (Protegido)",
        "description": "Permite al creador o auditor consultar las cuotas que fueron rechazadas. Si se envía 'asCreator=true', retorna únicamente las cuotas asumidas por el usuario autenticado.",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "asCreator",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Filtrar cuotas asumidas por el usuario logueado"
          },
          {
            "name": "creatorId",
